@page "/register"

<PageTitle>Регистрация — 424 Sport Predict</PageTitle>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">424 <span>Sport Predict</span></div>
        <h2 class="auth-title">Создать аккаунт</h2>
        <p class="auth-sub">Только для лиц старше 18 лет</p>

        @if (errorMessage is not null)
        {
            <div class="auth-error">@errorMessage</div>
        }

        @* HTML-форма → POST /auth/register → AuthController.RegisterPost *@
        <form method="post" action="/auth/register">
            <AntiforgeryToken />

            <div class="form-group">
                <label>Email</label>
                <input name="Email" type="email" class="form-input"
                       placeholder="your@email.com" required />
            </div>

            <div class="form-group">
                <label>Отображаемое имя</label>
                <input name="DisplayName" type="text" class="form-input"
                       placeholder="Ваше имя" required minlength="2" maxlength="60" />
            </div>

            <div class="form-group">
                <label>Дата рождения</label>
                <input name="DateOfBirth" type="date" class="form-input"
                       max="@MaxDate" required />
                <span class="field-hint">Для регистрации необходимо быть старше 18 лет</span>
            </div>

            <div class="form-group">
                <label>Пароль</label>
                <input name="Password" type="password" class="form-input"
                       placeholder="Минимум 6 символов и цифра" required minlength="6" />
            </div>

            <div class="form-group">
                <label>Подтверждение пароля</label>
                <input name="ConfirmPassword" type="password" class="form-input"
                       placeholder="Повторите пароль" required />
            </div>

            <button type="submit" class="btn-primary">Зарегистрироваться</button>
        </form>

        <p class="auth-switch">Уже есть аккаунт? <a href="/login">Войти</a></p>
    </div>
</div>

@code {
    private string? errorMessage;

    // Максимальная дата рождения = сегодня минус 18 лет (браузерная защита)
    private string MaxDate => DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd");

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorParam { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(ErrorParam))
        {
            errorMessage = string.Join(" ", ErrorParam
                .Split('|')
                .Select(e => e.Contains(':') ? e[(e.IndexOf(':') + 1)..] : e));
        }
    }
}
