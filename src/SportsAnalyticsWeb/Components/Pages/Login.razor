@page "/login"

<PageTitle>Вход — 424 Sport Predict</PageTitle>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">424 <span>Sport Predict</span></div>
        <h2 class="auth-title">Добро пожаловать</h2>
        <p class="auth-sub">Войдите в свой аккаунт</p>

        @if (errorMessage is not null)
        {
            <div class="auth-error">@errorMessage</div>
        }

        @* Обычная HTML-форма отправляет POST на MVC-контроллер AuthController.
           Это единственный надёжный способ записать Identity-cookie в Blazor Server. *@
        <form method="post" action="/auth/login">
            <AntiforgeryToken />

            <div class="form-group">
                <label>Email</label>
                <input name="Email" type="email" class="form-input" placeholder="your@email.com" required />
            </div>

            <div class="form-group">
                <label>Пароль</label>
                <input name="Password" type="password" class="form-input" placeholder="Ваш пароль" required />
            </div>

            <div class="form-group form-check">
                <input name="RememberMe" type="checkbox" id="rememberMe" value="true" />
                <label for="rememberMe">Запомнить меня</label>
            </div>

            <button type="submit" class="btn-primary">Войти</button>
        </form>

        <p class="auth-switch">Нет аккаунта? <a href="/register">Зарегистрироваться</a></p>
    </div>
</div>

@code {
    private string? errorMessage;

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorParam { get; set; }

    protected override void OnInitialized()
    {
        if (ErrorParam == "invalid")
        {
            errorMessage = "Неверный email или пароль.";
        }
        else if (!string.IsNullOrEmpty(ErrorParam))
        {
            // Разбираем ошибки вида "FieldName:Message|FieldName:Message"
            errorMessage = string.Join(" ", ErrorParam
                .Split('|')
                .Select(e => e.Contains(':') ? e[(e.IndexOf(':') + 1)..] : e));
        }
    }
}
