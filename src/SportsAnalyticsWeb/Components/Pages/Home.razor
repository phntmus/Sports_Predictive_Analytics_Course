@page "/"
@attribute [Authorize]
@inject IOddsPredictionService PredictionService
@inject ITeamRepository TeamRepository

<PageTitle>424 Sport Predict</PageTitle>

<section class="hero">
    <div>
        <span class="badge">Предиктивная аналитика</span>
        <h1>424 Sport Predict</h1>
        <p>Система анализирует историю матчей, рейтинги ELO и прошлые рыночные коэффициенты, формируя прогнозные вероятности и расчётные коэффициенты.</p>
        <a href="/calculate" class="btn-hero">Рассчитать прогноз</a>
    </div>
    <div class="formula-card">
        <h3>Базовая формула</h3>
        <code>P = 0.45·ELO + 0.30·Form + 0.25·Market</code>
        <code>Odds = 1 / (P · (1 + margin))</code>
    </div>
</section>

@if (predictions is null || teams is null)
{
    <div class="loading">
        <div class="spinner"></div>
        <p>Загрузка прогнозов...</p>
    </div>
}
else
{
    <h2 class="section-title">Ближайшие события</h2>
    <div class="cards">
        @foreach (var item in predictions)
        {
            var parts = item.MatchName.Split(" — ");
            var homeName = parts.Length > 0 ? parts[0] : "";
            var awayName = parts.Length > 1 ? parts[1] : "";
            var homeLogo = teams.FirstOrDefault(t => t.Name == homeName)?.LogoUrl ?? "";
            var awayLogo = teams.FirstOrDefault(t => t.Name == awayName)?.LogoUrl ?? "";

            <div class="match-card">
                <div class="match-card-teams">
                    @if (!string.IsNullOrEmpty(homeLogo))
                    {
                        <img src="@homeLogo" class="crest-sm" alt="@homeName" title="@homeName" />
                    }
                    <span class="match-vs-label">@item.MatchName</span>
                    @if (!string.IsNullOrEmpty(awayLogo))
                    {
                        <img src="@awayLogo" class="crest-sm" alt="@awayName" title="@awayName" />
                    }
                </div>
                <div class="odds-row"><span>П1</span><b>@item.HomeWinOdds</b><small>@Percent(item.HomeWinProbability)</small></div>
                <div class="odds-row"><span>Х</span><b>@item.DrawOdds</b><small>@Percent(item.DrawProbability)</small></div>
                <div class="odds-row"><span>П2</span><b>@item.AwayWinOdds</b><small>@Percent(item.AwayWinProbability)</small></div>
            </div>
        }
    </div>
}

@code {
    private List<PredictionResult>? predictions;
    private List<Team>? teams;

    protected override async Task OnInitializedAsync()
    {
        predictions = await PredictionService.GetUpcomingPredictionsAsync();
        teams = await TeamRepository.GetAllAsync();
    }

    private static string Percent(double value) => $"{value:P1}";
}
