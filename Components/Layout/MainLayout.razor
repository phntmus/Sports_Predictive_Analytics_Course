@inherits LayoutComponentBase
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="shell">
            <aside class="sidebar">
                <div class="brand">424 <span>Sport Predict</span></div>

                <NavLink href="" Match="NavLinkMatch.All">Панель</NavLink>
                <NavLink href="calculate">Расчёт прогноза</NavLink>
                <NavLink href="matches">Матчи</NavLink>
                <NavLink href="odds">Коэффициенты</NavLink>
                <NavLink href="teams">Команды</NavLink>

                <div class="sidebar-spacer"></div>

                <div class="user-info">
                    <span class="user-name">@context.User.Identity?.Name</span>
                </div>

                <a href="/auth/logout" class="logout-link">Выйти</a>
            </aside>
            <main class="content">@Body</main>
        </div>
    </Authorized>
    <NotAuthorized>
        @{
            var isAuthPage = Navigation.Uri.Contains("/login") ||
                             Navigation.Uri.Contains("/register");
        }
        @if (isAuthPage)
        {
            @Body
        }
        else
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    </NotAuthorized>
</AuthorizeView>
