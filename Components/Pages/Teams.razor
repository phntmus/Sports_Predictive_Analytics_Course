@page "/teams"
@attribute [Authorize]
@inject ITeamRepository TeamRepository

<PageTitle>Команды — 424 Sport Predict</PageTitle>

<h1>Команды и рейтинги</h1>
<p class="page-subtitle">Рейтинг ELO используется как один из признаков модели прогнозирования</p>

@if (teams is null)
{
    <div class="loading"><div class="spinner"></div><p>Загрузка...</p></div>
}
else
{
    <div class="teams-grid">
        @foreach (var team in teams)
        {
            <div class="team-card">
                <div class="team-card-header">
                    <img src="@team.LogoUrl" class="crest-xl" alt="@team.Name герб" />
                    <div>
                        <div class="team-card-name">@team.Name</div>
                        <div class="team-card-league">@team.League</div>
                    </div>
                </div>
                <div class="team-card-elo">
                    <span class="elo-label">ELO</span>
                    <span class="elo-value">@team.EloRating.ToString("F0")</span>
                </div>
                @if (team.Statistic is not null)
                {
                    <div class="team-stats-row">
                        <div class="stat-item">
                            <span class="stat-val">@team.Statistic.MatchesPlayed</span>
                            <span class="stat-lbl">Матчей</span>
                        </div>
                        <div class="stat-item stat-win">
                            <span class="stat-val">@team.Statistic.Wins</span>
                            <span class="stat-lbl">Победы</span>
                        </div>
                        <div class="stat-item stat-draw">
                            <span class="stat-val">@team.Statistic.Draws</span>
                            <span class="stat-lbl">Ничьи</span>
                        </div>
                        <div class="stat-item stat-loss">
                            <span class="stat-val">@team.Statistic.Losses</span>
                            <span class="stat-lbl">Поражения</span>
                        </div>
                    </div>
                    <div class="goals-row">
                        <span class="goals-for">@team.Statistic.GoalsFor забитых</span>
                        <span class="goals-against">@team.Statistic.GoalsAgainst пропущено</span>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<Team>? teams;

    protected override async Task OnInitializedAsync()
    {
        teams = await TeamRepository.GetAllAsync();
    }
}
